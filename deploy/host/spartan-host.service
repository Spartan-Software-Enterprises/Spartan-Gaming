[Unit]
Description=Spartan Gaming Host
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spartan
Group=spartan
WorkingDirectory=/opt/spartan-gaming
EnvironmentFile=-/etc/spartan-gaming/host.env
Environment=SPARTAN_HOST_BIND=127.0.0.1
Environment=SPARTAN_HOST_PORT=8787
Environment=SPARTAN_HOST_ID=spartan-host
Environment=SPARTAN_HOST_NAME=Spartan Host
ExecStart=/usr/bin/node /opt/spartan-gaming/host/agent.mjs --bind ${SPARTAN_HOST_BIND} --port ${SPARTAN_HOST_PORT} --id ${SPARTAN_HOST_ID} --name ${SPARTAN_HOST_NAME}
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/spartan-gaming
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
