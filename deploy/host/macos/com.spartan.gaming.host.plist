<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.spartan.gaming.host</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/opt/spartan-gaming/host/agent.mjs</string>
    <string>--id</string>
    <string>REPLACE_HOST_ID</string>
    <string>--name</string>
    <string>Spartan Host</string>
    <string>--bind</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8787</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/opt/spartan-gaming</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SPARTAN_HOST_ROOT</key>
    <string>/opt/spartan-gaming</string>
    <key>SPARTAN_HOST_CONFIGURED</key>
    <string>true</string>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
